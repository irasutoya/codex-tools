{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Codex Tools",
  "version": "0.1.0",
  "identifier": "io.github.irasutoya.codex-tools",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{ "title": "Codex Tools", "width": 1280, "height": 800, "minWidth": 960, "minHeight": 640 }],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "category": "DeveloperTool",
    "shortDescription": "Codex Provider、账号与会话管理工具",
    "longDescription": "在不注入 Codex 的前提下管理第三方 API、官方账号、Chat Completions 兼容代理与会话数据库修复。",
    "copyright": "Copyright © 2026 Codex Tools contributors",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false
      }
    }
  }
}
