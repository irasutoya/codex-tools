{
  "name": "codex-tools",
  "private": true,
  "version": "0.1.0",
  "description": "Lightweight Tauri manager and local Responses proxy for Codex.",
  "author": "Codex Tools contributors",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/irasutoya/codex-tools.git"
  },
  "type": "module",
  "scripts": {
    "dev": "tauri dev",
    "frontend:dev": "vite",
    "build": "vite build",
    "verify": "npm run format:check && npm run lint && npm run typecheck && npm run test",
    "check": "npm run verify && npm run build",
    "lint": "eslint src",
    "format": "prettier --write \"src/**/*.{ts,tsx}\" \"*.{json,md,yml}\" \".github/**/*.yml\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx}\" \"*.{json,md,yml}\" \".github/**/*.yml\"",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "tauri": "tauri",
    "dist:win": "tauri build"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.8.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6"
  },
  "devDependencies": {
    "@base-ui/react": "^1.6.0",
    "@eslint/js": "^10",
    "@tailwindcss/vite": "^4",
    "@tauri-apps/cli": "^2.8.0",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^5.1.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "eslint": "^10",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17",
    "lucide-react": "^1.24.0",
    "prettier": "^3.8.3",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "shadcn": "^4.13.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.4.0",
    "typescript": "~6",
    "typescript-eslint": "^8",
    "vite": "^7.2.4",
    "vitest": "^4.0.18"
  }
}
